# Generated from modules/colorschemes/themes/{id}.toml.

set -g status-style "bg={background},fg={foreground}"
set -g status-left-style "bg={black},fg={bright_yellow},bold"
set -g status-right-style "bg={black},fg={bright_green}"
set -g window-status-current-style "bg={selection},fg={bright_yellow},bold"
set -g window-status-style "bg={background},fg={bright_black}"
set -g pane-border-style "fg={selection}"
set -g pane-active-border-style "fg={bright_blue}"
set -g message-style "bg={black},fg={foreground}"
set -g mode-style "bg={selection},fg={bright_yellow}"
